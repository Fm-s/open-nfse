{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/coverage",
      "!**/specs",
      "!**/schemas",
      "!**/examples",
      "!**/docs/api",
      "!**/docs/.vitepress/dist",
      "!**/docs/.vitepress/cache",
      "!**/src/nfse/_rtc-schemas.generated.ts"
    ]
  }
}
